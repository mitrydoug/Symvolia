{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Shared/base config for the IPFS reverse-proxy. Per-environment settings
  // (name, vars, routes) live under `env.*` below so one src/index.js can feed
  // multiple sites. Always deploy WITH an explicit `--env` (e.g. `--env test`);
  // a bare `wrangler deploy` would publish an unconfigured top-level Worker.
  "name": "symvolia-ipfs-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-04-23",
  "observability": {
    "enabled": true
  },
  "env": {
    // Test site (test.symvolia.org), fed by the develop branch. CI deploys this
    // with `wrangler deploy --env test --var IPFS_CID:<cid>` (see
    // .github/workflows/deploy-site.yaml).
    "test": {
      "name": "test-symvolia",
      "vars": {
        // Pinata gateway CUSTOM DOMAIN. Pinata will not serve HTML over the
        // shared *.mypinata.cloud host (ERR_ID:00023), and this must differ
        // from the Worker's own public domain or requests would loop.
        "IPFS_GATEWAY": "ipfs.symvolia.org",
        // CID of the current build. CI overrides this per deploy via
        // `--var IPFS_CID:<cid>`; the placeholder is only for manual/local runs.
        "IPFS_CID": "REPLACE_WITH_CURRENT_BUILD_CID"
      },
      // Binds this Worker to the test site's clean domain. Cloudflare provisions
      // TLS and manages the routing DNS record for a Custom Domain.
      "routes": [
        {
          "pattern": "test.symvolia.org",
          "custom_domain": true
        }
      ]
    },
    // Production site (symvolia.org), fed by the release branch. NOT LIVE YET —
    // this block is a stub: the Pinata gateway custom domain, the apex DNS
    // custom-domain route, and the release-branch CI deploy still need wiring
    // (see Phase 6 of docs/productionization-checklist.md). CI will deploy with
    // `wrangler deploy --env production --var IPFS_CID:<cid>`.
    "production": {
      "name": "symvolia",
      "vars": {
        // Same Pinata gateway custom domain as test (reused); must differ from
        // the Worker's own public domain (symvolia.org) or requests would loop.
        "IPFS_GATEWAY": "ipfs.symvolia.org",
        // CID of the current build. CI overrides this per deploy via
        // `--var IPFS_CID:<cid>`; the placeholder is only for manual/local runs.
        "IPFS_CID": "REPLACE_WITH_CURRENT_BUILD_CID",
        // CSP delivery mode (read by applySecurityHeaders in src/index.js).
        // Start in "report-only" so missed hosts surface as violation reports
        // instead of breaking the proof → register → vote flow; flip to
        // "enforce" once alpha traffic produces zero legitimate CSP violations.
        "CSP_MODE": "report-only"
      },
      // Binds this Worker to the apex domain. Cloudflare provisions TLS and
      // manages the routing DNS record for the Custom Domain.
      "routes": [
        {
          "pattern": "symvolia.org",
          "custom_domain": true
        }
      ]
    }
  }
}