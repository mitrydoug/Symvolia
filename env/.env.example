# Local development secrets — copy to env/.env.local (gitignored) and fill in.
# These are the ONLY secrets required for local dev. Everything non-secret lives
# in env/profiles/*.env. Public/deploy secrets live in GitHub Actions Secrets.

# Base Sepolia HTTP RPC used by Hardhat for deploys/forks.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/REPLACE_WITH_KEY

# Base Sepolia HTTP RPC used by the backend indexer (pull-based log polling).
BASE_SEPOLIA_INDEXER_RPC_URL=https://base-sepolia.g.alchemy.com/v2/REPLACE_WITH_KEY

# Base Sepolia HTTP RPC the backend relay forwards frontend reads to.
# Use a dedicated app to separate frontend quota from the indexer.
BASE_SEPOLIA_RELAY_RPC_URL=https://base-sepolia.g.alchemy.com/v2/REPLACE_WITH_KEY
