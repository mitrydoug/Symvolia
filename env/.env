# Shared non-secret defaults for local dev infrastructure.
# Loaded before the selected profile by scripts/profile-env.sh.
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_BACKEND_URL=http://localhost:8000
LOCAL_BACKEND_RPC_URL=http://localhost:8000/rpc
MEILI_URL=http://localhost:7700
MEILI_API_KEY=dev-master-key
MEILI_READY_TIMEOUT_SECONDS=120
CONTRACT_READY_TIMEOUT_SECONDS=600

# Local backend service config (dev convenience, non-secret).
MEILI_SEMANTIC_SEARCH_ENABLED=true
MEILI_SEMANTIC_EMBEDDER_NAME=statement-text
MEILI_SEMANTIC_EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEILI_TASK_TIMEOUT_MS=300000
CORS_ORIGINS=*

# Gas sponsorship webhook approves only allowlisted contract writes.
ALCHEMY_GAS_SPONSORSHIP_INSPECT_APPROVE=true

# ── Frontend (Vite) dev defaults ──────────────────────────────────────────────
# Read by Vite via envDir=../env. Profiles (and CI) override VITE_NETWORK,
# VITE_RPC_URL, VITE_BACKEND_URL, etc. Non-secret values only.
VITE_REGISTRY_MODE=dev
VITE_NETWORK=localhost
VITE_RPC_URL=http://localhost:8000/rpc
VITE_BACKEND_URL=http://localhost:8000
VITE_ENABLE_BACKEND_SEARCH=true
VITE_PRIVY_APP_ID=cmpu9bmad00wo0cjojg34mdf3
VITE_CHART_PERIOD_SECONDS=360
VITE_BLOCK_POLLING_INTERVAL_SECONDS=60
# Also treat a small viewport as mobile so the mobile "coming soon" placeholder
# can be previewed with Chrome DevTools' device toolbar. Dev/test only.
VITE_ENABLE_VIEWPORT_MOBILE_DETECTION=true
VITE_ENABLE_GAS_SPONSORSHIP=true
VITE_ALCHEMY_GAS_POLICY_ID=463d4624-ecba-4626-b4f0-ace5edcc4279
