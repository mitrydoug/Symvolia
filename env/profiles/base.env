# Backend deployment profile for Base mainnet (production).
#
# This file exists for ONE reason: scripts/lib/backend-config.mjs reads
# INDEXER_ENABLED from env/profiles/<deploymentProfile>.env, and
# deployments/base.json sets deploymentProfile="base". Without this file the
# derivation defaults INDEXER_ENABLED to true (the backend default), which would
# start the indexer on the prod Railway service with no INDEXER_RPC_URL set.
#
# The frontend production build does NOT use this profile — it uses
# env/profiles/release.env (selected by the release branch in deploy-site.yaml).
#
# Indexing + Meilisearch search are OFF for alpha (matching base-sepolia). The
# RPC relay and gas-sponsorship endpoints still serve. To re-enable indexing,
# set INDEXER_ENABLED=true and provide the BACKEND_INDEXER_RPC_URL_PRODUCTION
# secret (wired to INDEXER_RPC_URL in deploy-backend-railway.yaml).
INDEXER_ENABLED=false
INDEXER_RPC_URL=""
