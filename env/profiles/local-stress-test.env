# Local dev — dev registry with stress-test fixture data.
# Focused on the browser-local search engine: Meilisearch indexing is disabled
# (INDEXER_ENABLED=false) and backend search is hidden in the UI
# (VITE_ENABLE_BACKEND_SEARCH=false). The Meilisearch container still runs so
# the backend — and its RPC relay that the frontend reads chain data through —
# boots normally; the search index just stays empty.
INDEXER_RPC_URL=${LOCAL_RPC_URL}
INDEXER_ENABLED=false
RELAY_RPC_URL=${LOCAL_RPC_URL}
VITE_RPC_URL=${LOCAL_BACKEND_RPC_URL}
VITE_BACKEND_URL=${LOCAL_BACKEND_URL}
VITE_NETWORK=localhost
VITE_REGISTRY_MODE=dev
VITE_ENABLE_BACKEND_SEARCH=false
VITE_SEARCH_RESULTS_LIMIT=100
DEPLOY_NETWORK=localhost
DEPLOYMENT_PROFILE=local-stress-test
SEED_PROFILE=stress
STRESS_FORUM=global
