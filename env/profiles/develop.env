# CI deploy profile — develop branch → Base Sepolia, deployed dev backend.
# Frontend-only build config. RPC + search point at the deployed dev backend.
BACKEND_URL=https://symvolia-backend-development.up.railway.app
VITE_NETWORK=base_sepolia
VITE_REGISTRY_MODE=mock
VITE_RPC_URL=${BACKEND_URL}/rpc
VITE_BACKEND_URL=${BACKEND_URL}
# Backend text search is disabled while Meilisearch is offline; other backend
# endpoints (gas-sponsorship eligibility) still work via VITE_BACKEND_URL.
VITE_ENABLE_BACKEND_SEARCH=false
VITE_ENABLE_GAS_SPONSORSHIP=true
VITE_CHART_PERIOD_SECONDS=86400
# Dev/test site: also treat a small viewport as mobile so the mobile
# "coming soon" placeholder is previewable via the browser device toolbar.
VITE_ENABLE_VIEWPORT_MOBILE_DETECTION=true

REQUIRE="VITE_NETWORK VITE_REGISTRY_MODE VITE_RPC_URL VITE_ENABLE_GAS_SPONSORSHIP VITE_ALCHEMY_GAS_POLICY_ID"
