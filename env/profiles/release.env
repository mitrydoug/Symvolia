# CI deploy profile — release branch → Base mainnet, deployed prod backend.
# Frontend-only build config. RPC + search point at the deployed prod backend.
BACKEND_URL=https://symvolia-backend-production.up.railway.app
VITE_NETWORK=base
VITE_REGISTRY_MODE=production
VITE_RPC_URL=${BACKEND_URL}/rpc
VITE_BACKEND_URL=${BACKEND_URL}
# Backend text search is disabled while Meilisearch is offline; other backend
# endpoints (gas-sponsorship eligibility) still work via VITE_BACKEND_URL.
VITE_ENABLE_BACKEND_SEARCH=false
VITE_ENABLE_GAS_SPONSORSHIP=true
VITE_ALCHEMY_GAS_POLICY_ID=818cbfc5-e5fa-4dc8-bc0c-fd85d7051e64
# Production Privy app (SEPARATE from the test app). The shared env/.env default
# is the TEST app id; mainnet MUST override it so the prod site runs on the
# domain-locked prod app (symvolia.org) rather than the test app.
VITE_PRIVY_APP_ID=cmuudr2o801b00dl7f7sa47l8
# Show the mobile "coming soon" placeholder. Real mobile user-agents always see
# it (robust UA detection in useIsMobileVisitor); this flag ALSO treats a narrow
# viewport (<600px, MUI `sm`) as mobile. Mobile isn't supported for alpha, so
# keep it on for prod.
VITE_ENABLE_VIEWPORT_MOBILE_DETECTION=true
VITE_CHART_PERIOD_SECONDS=86400
REQUIRE="VITE_NETWORK VITE_REGISTRY_MODE VITE_RPC_URL VITE_ENABLE_GAS_SPONSORSHIP VITE_ALCHEMY_GAS_POLICY_ID VITE_PRIVY_APP_ID"
