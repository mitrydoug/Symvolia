# Local dev — Base Sepolia fork with the same dev-registry topology.
# Requires BASE_SEPOLIA_RPC_URL (the fork source) in .env.local.
INDEXER_RPC_URL=${LOCAL_RPC_URL}
RELAY_RPC_URL=${LOCAL_RPC_URL}
VITE_RPC_URL=${LOCAL_BACKEND_RPC_URL}
VITE_BACKEND_URL=${LOCAL_BACKEND_URL}
VITE_NETWORK=localhost
VITE_REGISTRY_MODE=dev
DEPLOY_NETWORK=localhost
DEPLOYMENT_PROFILE=local-base-sepolia-fork
SEED_PROFILE=none
HARDHAT_NETWORK=local_base_sepolia_fork
REQUIRE="BASE_SEPOLIA_RPC_URL"
