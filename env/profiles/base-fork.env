# Local dev — Base MAINNET fork running the REAL production registry topology.
# Deploys the real SymvoliaRegistry pointed at the forked Base-mainnet zkPassport
# verifier (0x1D00…), so the full on-chain proof verification path can be
# exercised locally. Requires BASE_RPC_URL (the fork source) in .env.local.
#
# Serve the frontend at http://localhost:<port> (NOT 127.0.0.1): the registry's
# on-chain domain is "localhost" and SymvoliaRegistry enforces the service scope
# (domain) against the proof, so the host the browser is opened on must match.
# The chain binding is "local" (chainId 31337, the fork node's reported id) and
# the subscope is "symvolia-verify", matching the deployed registry.
# Indexing is disabled (INDEXER_ENABLED=false), matching the production profiles:
# this env targets the on-chain zkPassport registration flow, not search. The
# indexer won't start and Meilisearch stays empty; the search API and RPC relay
# still serve. Set INDEXER_ENABLED=true to re-enable chain polling + indexing.
INDEXER_ENABLED=false
INDEXER_RPC_URL=${LOCAL_RPC_URL}
RELAY_RPC_URL=${LOCAL_RPC_URL}
VITE_RPC_URL=${LOCAL_BACKEND_RPC_URL}
VITE_BACKEND_URL=${LOCAL_BACKEND_URL}
VITE_NETWORK=localhost
VITE_REGISTRY_MODE=production
DEPLOY_NETWORK=localhost
DEPLOYMENT_PROFILE=base-fork
SEED_PROFILE=none
HARDHAT_NETWORK=local_base_mainnet_fork
# Do NOT pin BASE_MAINNET_FORK_BLOCK_NUMBER: a fork anchors block.timestamp to
# the forked block and only advances it via local mining (it never jumps to
# real wall-clock). A pinned block is stale-on-arrival — by the time you scan a
# passport, block.timestamp lags the proof's generation date and the zkPassport
# verifier reverts "The proof was generated outside the validity period".
# Leaving it unset forks the latest block (anchor ≈ now); the contracts step
# then realigns the chain clock to real time and keeps it advancing (see
# scripts/dev/contracts.sh, realign_fork_clock).
REQUIRE="BASE_RPC_URL"
