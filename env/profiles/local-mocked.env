# Local dev — mock registry (full zkPassport proof flow, no on-chain verifier).
# MockSymvoliaRegistry parses the proof params to recover the identity and
# nationality, so there is no auto-seed: register through the real zkPassport
# UI flow in the frontend (SEED_PROFILE=none).
#
# The mock registry does NOT enforce the service scope (domain), only the
# subscope ("symvolia-verify"), so the frontend can be opened on any host
# (e.g. 127.0.0.1 or localhost) regardless of where the contract was deployed.
INDEXER_RPC_URL=${LOCAL_RPC_URL}
RELAY_RPC_URL=${LOCAL_RPC_URL}
VITE_RPC_URL=${LOCAL_BACKEND_RPC_URL}
VITE_BACKEND_URL=${LOCAL_BACKEND_URL}
VITE_NETWORK=localhost
VITE_REGISTRY_MODE=mock
DEPLOY_NETWORK=localhost
DEPLOYMENT_PROFILE=local-mocked
SEED_PROFILE=none
